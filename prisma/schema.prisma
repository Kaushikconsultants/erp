  workingHoursStart    String   @default("09:00")
  workingHoursEnd      String   @default("19:00")
  outOfOfficeMessage   String   @default("We are currently unavailable. We will respond during working hours 9 AM - 7 PM.")
  slaWarningMinutes    Int      @default(15)
