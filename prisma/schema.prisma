  toolsCalled  String   @default("none")  // comma-separated: lookupOrder, searchProducts, recommendSize
  status       String   @default("SUCCESS") // SUCCESS, FAILED, SKIPPED
  errorMessage String?
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())
