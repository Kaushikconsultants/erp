model WhatsAppFlowState {
  id            String   @id @default(uuid())
  phone         String   @unique
  flowId        String
  currentNodeId String
  variables     String   @default("{}")  // JSON: captured user inputs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
