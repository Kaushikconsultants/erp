  welcomeMessage       String   @default("Welcome! How can we help you today?")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------
// WhatsApp Canned Responses (Quick Replies)
// ---------------------------------------------------------
model WhatsAppCannedResponse {
  id        String   @id @default(uuid())
  title     String
  shortcut  String?  @unique
  content   String
  category  String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Comprehensive Tax & GST Settings Suite
// ---------------------------------------------------------
model TaxRate {
  id          String   @id @default(uuid())
  name        String
  type        String   // CGST, SGST, IGST, UTGST, CESS, Tax Group
  rate        Float    // e.g. 5, 2.5, 9, 18, 12, 28, 0
  isGroup     Boolean  @default(false)
  subTaxes    String?  // JSON array of sub-tax rate IDs for tax groups
  isDefault   Boolean  @default(false)
  status      String   @default("Active") // Active, Inactive
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaxExemption {
  id          String   @id @default(uuid())
  name        String   // e.g. "Special Economic Zone (SEZ)", "Export Goods"
  type        String   // Customer, Vendor, Item, Transaction
  reason      String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaxPreference {
  id                    String   @id @default(uuid())
  taxPreference         String   @default("Taxable") // Taxable, Tax Exempt
  intraStateTaxRateId   String?
  interStateTaxRateId   String?
  itemTaxInclusiveness  String   @default("Tax Exclusive") // Tax Exclusive, Tax Inclusive
  defaultHsn            String?  @default("6109")
  enableReverseCharge   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GstSetting {
  id                  String   @id @default(uuid())
  gstin               String?
  legalName           String?
  tradeName           String?
  registeredState     String?  @default("Rajasthan")
  stateCode           String?  @default("08")
  isComposition       Boolean  @default(false)
  enableRcm           Boolean  @default(false)
  eWayBillThreshold   Float    @default(50000)
  enableEInvoicing    Boolean  @default(false)
  eInvoicingThreshold Float    @default(50000000)
  filingFrequency     String   @default("Monthly") // Monthly, Quarterly
  gstr1FilingDueDay   Int      @default(11)
  gstr3bFilingDueDay  Int      @default(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

