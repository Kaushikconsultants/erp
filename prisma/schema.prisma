generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// User & Role Management
// ---------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SALES")
  roleId    String?
  roleDef   Role?    @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true)
  canManageSettings Boolean @default(false)
  allowedSections   String? // Comma-separated or JSON array of section keys allowed for this user
  lastActiveAt      DateTime?
  presenceStatus    String?  @default("OFFLINE") // "ONLINE", "IDLE", "OFFLINE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?
  auditLogs AuditLog[]
  notifications Notification[]
  customerProfile Customer? @relation("CustomerUser")
  broadcastsCreated TeamBroadcast[] @relation("BroadcastAuthor")
  broadcastReplies BroadcastReply[]
  broadcastReads BroadcastRead[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String   // JSON string of permissions
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Employee & HR Management
// ---------------------------------------------------------
model Employee {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  employeeId      String   @unique // Company generated ID
  mobile          String?
  joiningDate     DateTime?
  department      String?
  designation     String?
  employmentStatus String  @default("Active")
  salary          Float?
  target          Float?
  bankDetails     String?
  address         String?
  emergencyContact String?
  notes           String?
  
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  managerId       String?
  manager         Employee? @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates    Employee[] @relation("ManagerToEmployee")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers       Customer[] @relation("AssignedSalesperson")
  calls           Call[]
  followUps       FollowUp[]
  tasksAssigned   Task[]     @relation("TaskAssignee")
  tasksCreated    Task[]     @relation("TaskCreator")
  orders          Order[]
  attendances     Attendance[]
  leaves          Leave[]
  salaries        Salary[]
  incentives      Incentive[]
  quotations      Quotation[]
  inventoryTransactions InventoryTransaction[]
  expenses        Expense[]
  round1Candidates Candidate[] @relation("CandidateRound1Interviewer")
  round2Candidates Candidate[] @relation("CandidateRound2Interviewer")
  round3Candidates Candidate[] @relation("CandidateRound3Interviewer")
  assignedWhatsAppConversations WhatsAppConversation[] @relation("AssignedAgent")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  leaderId    String?  @unique
  members     Employee[]
  whatsAppConversations WhatsAppConversation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Customer CRM
// ---------------------------------------------------------
model Customer {
  id              String   @id @default(uuid())
  businessName    String
  contactPerson   String
  mobile          String
  whatsappNumber  String?
  email           String?
  alternatePhone  String?
  gstNumber       String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  pincode         String?
  landmark        String?
  
  regularDiscount String?
  preferredPaymentMethod String?
  
  customerType    String?  // e.g., Wholesaler, Retailer
  businessCategory String? 
  source          String?  // e.g., Website, Reference, Cold Call

  status          String   @default("New Lead")
  leadStage       String   @default("Contacted")
  
  assignedSalespersonId String?
  assignedSalesperson   Employee? @relation("AssignedSalesperson", fields: [assignedSalespersonId], references: [id])

  lastContactDate DateTime?
  nextFollowUp    DateTime?
  notes           String?
  tags            String?

  healthScore          Float?
  leadScore            Int?
  temperature          String?  // HOT, WARM, COLD
  portalUserId         String?  @unique
  portalUser           User?    @relation("CustomerUser", fields: [portalUserId], references: [id])
  expectedValue        Float? @default(0)
  averageOrderCycleDays Int?
  preferences          String? // JSON string
  territoryId          String?
  territory            Territory? @relation(fields: [territoryId], references: [id])

  totalPurchaseValue Float @default(0)
  totalOrders        Int   @default(0)
  retentionStatus    String @default("Active")

  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calls           Call[]
  followUps       FollowUp[]
  tasks           Task[]
  orders          Order[]
  quotations      Quotation[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  ewayBills       EWayBill[]
  payments        Payment[]

  whatsAppConversations WhatsAppConversation[]
  whatsAppPaymentLinks  WhatsAppPaymentLink[]
  whatsAppFormSubmissions WhatsAppFormSubmission[]
}

// ---------------------------------------------------------
// Sales & Activity (Calls, FollowUps, Tasks)
// ---------------------------------------------------------
model Call {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  callType     String   // Incoming / Outgoing
  durationSec  Int?
  status       String   // Connected, Missed, etc.
  outcome      String   // Order Confirmed, Call Back, etc.
  notes        String?
  nextAction   String?
  followUpDate DateTime?
  recordingUrl String?
  summary      String?

  createdAt    DateTime @default(now())
}

model FollowUp {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  followUpType String
  priority     String   @default("Medium")
  notes        String?
  expectedOutcome String?
  status       String   @default("Pending") // Pending, Completed, Rescheduled, Cancelled

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  priority     String   @default("Medium")
  dueDate      DateTime?
  status       String   @default("To Do")

  assigneeId   String
  assignee     Employee @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId    String
  creator      Employee @relation("TaskCreator", fields: [creatorId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------
// Products & Orders
// ---------------------------------------------------------
model Product {
  id              String   @id @default(uuid())
  name            String
  sku             String?  @unique
  articleNumber   String?  @unique
  hsnCode         String?
  category        String
  subCategory     String?
  fabric          String?
  color           String?
  size            String?
  purchasePrice   Float
  sellingPrice    Float
  mrp             Float
  stockQuantity   Int      @default(0)
  minimumStock    Int      @default(10)
  status          String   @default("Active")
  description     String?
  weight          Float?   @default(0)
  images          String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  creditNoteItems CreditNoteItem[]
  billItems       BillItem[]
  vendorCreditItems VendorCreditItem[]
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  weight      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // "IN", "OUT", "ADJUSTMENT"
  quantity    Int
  reference   String?  // Order ID, PO number, or manual scan
  date        DateTime @default(now())
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  notes       String?
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  salespersonId   String
  salesperson     Employee @relation(fields: [salespersonId], references: [id])
  
  orderDate       DateTime @default(now())
  deliveryDate    DateTime?
  
  totalValue      Float
  discount        Float    @default(0)
  tax             Float    @default(0)
  paymentReceived Float    @default(0)
  outstandingAmount Float  @default(0)

  paymentStatus   String   @default("Unpaid") // Unpaid, Partially Paid, Paid
  orderStatus     String   @default("Processing") // Processing, Packed, Dispatched, Delivered, Cancelled
  notes           String?

  // GST & Financial Fields
  placeOfSupply   String?
  subtotal        Float    @default(0)
  cgst            Float    @default(0)
  sgst            Float    @default(0)
  igst            Float    @default(0)
  isInterstate    Boolean  @default(false)

  // Shipping & Tracking fields
  awbNumber       String?
  courierName     String?
  trackingUrl     String?
  dispatchDate    DateTime?
  expectedDeliveryDate DateTime?
  shippingStatus  String? // e.g. "In Transit", "Out for Delivery", "Delivered", "RTO"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  ewayBills       EWayBill[]
  payments        Payment[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  quantity  Int
  rate      Float
  hsnCode   String? @default("6109")
  gstRate   Float   @default(12)
  cgst      Float   @default(0)
  sgst      Float   @default(0)
  igst      Float   @default(0)
  total     Float
}

// ---------------------------------------------------------
// Performance & Financials
// ---------------------------------------------------------
model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String   @default("Present") // Present, Absent, Half Day, Leave
  workingHours Float?
  notes       String?

  createdAt   DateTime @default(now())
}

model Leave {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  numberOfDays Int
  reason      String
  status      String   @default("Pending") // Pending, Approved, Rejected

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Salary {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       String   // e.g. "2023-10"
  basicSalary Float
  hra         Float    @default(0)
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  bonus       Float    @default(0)
  advance     Float    @default(0)
  netSalary   Float
  paymentDate DateTime?
  status      String   @default("Pending") // Pending, Processed, Paid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incentive {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  month           String   // e.g. "2023-10"
  eligibleSales   Float
  incentiveRate   Float
  incentiveEarned Float
  status          String   @default("Pending") // Pending, Approved, Paid

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------
// System & Admin
// ---------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  module      String
  recordId    String
  previousValue String? // JSON string
  newValue      String? // JSON string
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// Telecalling (Scripts & Objections)
// ---------------------------------------------------------
model CallScript {
  id          String   @id @default(uuid())
  stage       String   @unique // e.g. "New Lead", "Follow Up", "Negotiation"
  content     String   // The actual script content (can be markdown)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Objection {
  id          String   @id @default(uuid())
  concern     String   // e.g. "Price is too high"
  response    String   // The suggested response
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// CRM Additions
// ---------------------------------------------------------
model Territory {
  id          String   @id @default(uuid())
  name        String   @unique
  pincodes    String?  // comma-separated list
  description String?
  customers   Customer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // e.g. Alert, Reminder, Message
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model IncentiveRule {
  id          String   @id @default(uuid())
  name        String
  condition   String   // JSON string describing the condition
  rewardType  String   // e.g. Percentage, Fixed
  rewardValue Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Company Settings & Invoicing / Quotations
// ---------------------------------------------------------
model CompanySettings {
  id            String   @id @default("default")
  companyName   String   @default("Espon Clothing Private Limited")
  address       String   @default("Sco 71A , 2nd Floor , Ashoka PlazaDelhi Road")
  city          String   @default("Rohtak")
  state         String   @default("Haryana")
  pincode       String   @default("124001")
  country       String   @default("India")
  gstin         String?  @default("06AAHCE7721Q1Z4")
  pan           String?  @default("AAHCE7721Q")
  mobile        String?  @default("7206066678")
  email         String?  @default("clothingespon@gmail.com")
  website       String?  @default("www.espon.in")
  logoUrl       String?
  
  bankAccountName String? @default("ESPON CLOTHING PRIVATE LIMITED.")
  accountNumber   String? @default("016805006415")
  ifscCode        String? @default("ICIC0000168")
  branch          String? @default("Rohtak")
  upiId           String? @default("7206066678@OKBIZAXIS")
  
  signatoryUrl    String?
  signatoryName   String? @default("Ashish Aggarwal")
  signatoryDesignation String? @default("Authorized Signatory")
  
  themeColor      String? @default("#4f46e5")
  fontFamily      String? @default("Inter")
  buttonRadius    String? @default("8px")
  useBoldText     Boolean @default(false)
  monthlyTarget   Float   @default(2000000)

  callOutcomes    String[] @default(["Interested / Follow-up Needed", "Not Interested", "No Answer / Voicemail", "Order Placed", "Complaint / Support", "Call Back Later"])
  callTypes       String[] @default(["Outbound Call (Made by us)", "Inbound Call (Received from customer)", "In-person Meeting", "WhatsApp Chat"])

  nextQuotationNumber String? @default("QT-1001")
  nextInvoiceNumber   String? @default("INV-1001")

  updatedAt       DateTime @updatedAt
}

model Quotation {
  id              String   @id @default(uuid())
  quotationNumber String   @unique
  revisionNumber  Int      @default(0)
  parentQuoteId   String?
  referenceNumber String?
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  salespersonId   String
  salesperson     Employee @relation(fields: [salespersonId], references: [id])
  
  date            DateTime @default(now())
  expiryDate      DateTime?
  placeOfSupply   String?
  subject         String?
  shippingAddress String?
  billingAddress  String?

  currency        String   @default("INR")
  paymentTerms    String?
  priceList       String?
  warehouse       String?
  deliveryTerms   String?
  shippingMethod  String?
  expectedDeliveryDate DateTime?
  template        String   @default("Standard")

  subtotal        Float    @default(0)
  itemDiscount    Float    @default(0)
  additionalDiscount Float @default(0)
  taxableAmount   Float    @default(0)
  shippingCharges Float    @default(0)
  adjustment      Float    @default(0)
  roundOff        Float    @default(0)
  receivedAmount  Float    @default(0)
  taxTotal        Float    @default(0)
  cgst            Float    @default(0)
  sgst            Float    @default(0)
  igst            Float    @default(0)
  totalValue      Float
  totalQuantity   Float    @default(0)
  totalItems      Int      @default(0)
  totalWeight     Float?   @default(0)
  
  isInterstate    Boolean  @default(false)
  status          String   @default("Draft") // Draft, Sent, Viewed, Accepted, Declined, Expired, Converted
  approvalStatus  String   @default("Approved") // Pending Approval, Approved, Rejected
  
  notes           String?
  internalNotes   String?
  termsConditions String?

  viewedDate      DateTime?
  acceptedDate    DateTime?
  declinedDate    DateTime?
  ipAddress       String?
  digitalSignature String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           QuotationItem[]
  activities      QuotationActivity[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  
  sku         String?
  description String?
  hsnCode     String?   @default("6103")
  quantity    Float     @default(1)
  unit        String?   @default("pcs")
  unitWeight  Float?    @default(0)
  rate        Float
  discountPercent Float @default(0)
  discountAmount  Float @default(0)
  taxableAmount   Float @default(0)
  gstRate     Float     @default(0)
  taxAmount   Float     @default(0)
  cgst        Float     @default(0)
  sgst        Float     @default(0)
  igst        Float     @default(0)
  total       Float
  
  warehouse   String?
  availableStock Int?
}

model QuotationActivity {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String?
  action      String    // e.g. "Created", "Updated", "Sent", "Viewed", "Accepted"
  details     String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------
// NEW ERP MODELS (PHASE 1)
// ---------------------------------------------------------

model Branch {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]
  customers   Customer[]
  warehouses  Warehouse[]
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  address     String?
  managerId   String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]
}

model Vendor {
  id              String   @id @default(uuid())
  companyName     String
  contactPerson   String?
  email           String?  @unique
  mobile          String?
  gstNumber       String?
  pan             String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  paymentTerms    String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  bills           Bill[]
  payments        VendorPayment[]
  vendorCredits   VendorCredit[]
}

model PurchaseOrder {
  id              String   @id @default(uuid())
  poNumber        String   @unique
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  status          String   @default("Draft") // Draft, Issued, Partially Received, Received, Cancelled
  totalValue      Float    @default(0)
  taxAmount       Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseOrderItem[]
  bills           Bill[]
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  rate            Float
  taxAmount       Float         @default(0)
  total           Float
}

model Bill {
  id               String    @id @default(uuid())
  billNumber       String    @unique // Auto: BILL-0001
  vendorBillNumber String?   // Vendor Invoice / Bill Reference Number
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  
  billDate         DateTime  @default(now())
  dueDate          DateTime?
  paymentTerms     String?   @default("Net 30")
  
  subtotal         Float     @default(0)
  taxAmount        Float     @default(0)
  discountAmount   Float     @default(0)
  totalAmount      Float
  amountPaid       Float     @default(0)
  amountDue        Float
  
  status           String    @default("Open") // Draft, Open, Paid, Partially Paid, Overdue, Void
  notes            String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items            BillItem[]
  payments         VendorPayment[]
  vendorCredits    VendorCredit[]
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  
  description String
  hsnCode     String?  @default("6109")
  quantity    Int      @default(1)
  unit        String?  @default("pcs")
  rate        Float    @default(0)
  gstRate     Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
}

model VendorPayment {
  id               String    @id @default(uuid())
  paymentNumber    String    @unique // VPAY-2026-0001
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  billId           String?
  bill             Bill?     @relation(fields: [billId], references: [id])
  
  amount           Float
  paymentDate      DateTime  @default(now())
  paymentMode      String    // Bank Transfer (NEFT/RTGS), UPI, Cheque, Cash, Advance Adjustment, Other
  paidFromAccount  String?   // HDFC Bank Current A/c, ICICI Bank, Cash in Hand, etc.
  referenceNumber  String?   // UTR #, Cheque #, Transaction ID
  paymentType      String    @default("Bill Payment") // Bill Payment, Advance Deposit, On-Account
  status           String    @default("Completed") // Completed, Pending, Cancelled
  notes            String?
  recordedBy       String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model VendorCredit {
  id               String    @id @default(uuid())
  creditNoteNumber String    @unique // DN-0001 (Debit Note / Vendor Credit)
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  billId           String?
  bill             Bill?     @relation(fields: [billId], references: [id])
  
  creditDate       DateTime  @default(now())
  reason           String    // Goods Return, Rate Difference, Quality Rejection, Post-Purchase Discount, Other
  status           String    @default("OPEN") // OPEN, ADJUSTED, REFUNDED, CANCELLED
  
  subtotal         Float     @default(0)
  taxAmount        Float     @default(0)
  totalAmount      Float     @default(0)
  allocatedAmount  Float     @default(0)
  balanceAmount    Float     @default(0)
  
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items            VendorCreditItem[]
}

model VendorCreditItem {
  id             String       @id @default(uuid())
  vendorCreditId String
  vendorCredit   VendorCredit @relation(fields: [vendorCreditId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  
  description    String
  hsnCode        String?      @default("6109")
  quantity       Int          @default(1)
  rate           Float        @default(0)
  gstRate        Float        @default(0)
  taxAmount      Float        @default(0)
  total          Float        @default(0)
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id])
  invoiceDate     DateTime @default(now())
  dueDate         DateTime?
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float
  amountPaid      Float    @default(0)
  amountDue       Float
  status          String   @default("Unpaid") // Draft, Sent, Unpaid, Partially Paid, Paid, Overdue, Cancelled
  paymentTerms    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        Payment[]
  creditNotes     CreditNote[]
}

model CreditNote {
  id               String   @id @default(uuid())
  creditNoteNumber String   @unique // e.g. CN-1001
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id])
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  
  creditNoteDate   DateTime @default(now())
  reason           String   // Sales Return, Post-Sale Discount, Defective Goods, Price Correction, Other
  status           String   @default("OPEN") // OPEN, ADJUSTED, REFUNDED, CANCELLED
  
  subtotal         Float    @default(0)
  taxAmount        Float    @default(0)
  cgst             Float    @default(0)
  sgst             Float    @default(0)
  igst             Float    @default(0)
  totalAmount      Float    @default(0)
  allocatedAmount  Float    @default(0)
  balanceAmount    Float    @default(0)

  restockReturnedGoods Boolean @default(true) // Automatically replenish warehouse stock

  notes            String?
  termsConditions  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            CreditNoteItem[]
}

model CreditNoteItem {
  id            String     @id @default(uuid())
  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id])
  
  description   String
  sku           String?
  hsnCode       String?    @default("6109")
  quantity      Float      @default(1)
  unit          String?    @default("pcs")
  rate          Float      @default(0)
  taxableAmount Float      @default(0)
  gstRate       Float      @default(0)
  taxAmount     Float      @default(0)
  cgst          Float      @default(0)
  sgst          Float      @default(0)
  igst          Float      @default(0)
  total         Float      @default(0)
}

model EWayBill {
  id              String    @id @default(uuid())
  ewbNumber       String    @unique // 12-digit EWB Number e.g. 141289345678
  ewbDate         DateTime  @default(now())
  validUntil      DateTime?
  
  // Document Reference
  docType         String    @default("Tax Invoice") // Tax Invoice, Bill of Supply, Delivery Challan, Credit Note
  docNumber       String    // e.g. INV-1001, CN-1001, ORD-1001
  docDate         DateTime  @default(now())
  
  // Links
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  // Supply Type & Transaction
  supplyType      String    @default("Outward") // Outward, Inward
  subSupplyType   String    @default("Supply") // Supply, Export, Job Work, For Own Use, Recipient Not Known, Line Sales
  transactionType String    @default("Regular") // Regular, Bill To - Ship To, Bill From - Dispatch From
  
  // Consignor (From) Details
  fromGstin       String?
  fromTradeName   String?
  fromAddress     String?
  fromPlace       String?
  fromPincode     String?
  fromState       String?
  
  // Consignee (To) Details
  toGstin         String?
  toTradeName     String?
  toAddress       String?
  toPlace         String?
  toPincode       String?
  toState         String?

  // Goods Summary & Values
  totalTaxableAmount Float  @default(0)
  cgstAmount         Float  @default(0)
  sgstAmount         Float  @default(0)
  igstAmount         Float  @default(0)
  cessAmount         Float  @default(0)
  totalInvoiceValue  Float  @default(0)
  mainHsnCode        String?
  
  // Part B (Transporter & Vehicle Details)
  transporterId   String?  // Transporter GSTIN or Transporter ID
  transporterName String?
  transportMode   String   @default("Road") // Road, Rail, Air, Ship
  approxDistanceKm Int     @default(100)
  vehicleType     String   @default("Regular") // Regular, Over Dimensional Cargo
  vehicleNumber   String?  // e.g. DL-01-AB-1234
  docNoOrLorryReceipt String? // LR/GR/RR/Airway Bill Number
  docDatePartB    DateTime?
  
  status          String   @default("GENERATED") // GENERATED, ACTIVE, EXTENDED, CANCELLED
  cancelReason    String?
  
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id               String    @id @default(uuid())
  paymentNumber    String    @unique
  invoiceId        String?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id])
  paymentType      String    @default("Invoice Payment") // Invoice Payment, Advance Payment, On-Account, Quotation Advance
  amount           Float
  paymentDate      DateTime  @default(now())
  paymentMode      String    // Cash, Bank Transfer, UPI, Cheque, Card, Online Gateway, Advance Adjustment, Other
  receivingAccount String?   // HDFC Bank Current A/c, ICICI Bank, SBI Current A/c, Petty Cash, Store Counter, UPI QR, etc.
  referenceNumber  String?   // UTR / Cheque / Transaction / IMPS / Slip Number
  payerName        String?   // Name of person/company paying
  status           String    @default("Completed") // Completed, Pending Realization, Failed, Refunded, Cancelled
  notes            String?
  recordedBy       String?   // Staff name who recorded payment
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Expense {
  id              String   @id @default(uuid())
  expenseNumber   String   @unique
  date            DateTime @default(now())
  category        String   // Travel, Meals, Supplies, etc.
  amount          Float
  description     String?
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  status          String   @default("Pending") // Pending, Approved, Rejected, Paid
  receiptUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MobileScanSession {
  id          String   @id @default(uuid())
  sessionCode String   @unique
  scannedCode String?
  mode        String   @default("INVENTORY") // INVENTORY, PACKING
  orderId     String?
  status      String   @default("ACTIVE")    // ACTIVE, CONNECTED, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Omnichannel & Automated Workflows
// ---------------------------------------------------------
model CommunicationLog {
  id           String   @id @default(uuid())
  type         String   // WHATSAPP, EMAIL, SMS
  recipient    String
  message      String
  status       String   @default("SENT")
  triggerEvent String?
  createdAt    DateTime @default(now())
}

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String   // UNPAID_INVOICE_7_DAYS, NEW_ORDER, NEW_LEAD
  action      String   // SEND_WHATSAPP, CREATE_TASK, SEND_EMAIL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Hiring & 3-Round Interview Evaluation Module
// ---------------------------------------------------------
model Candidate {
  id              String   @id @default(uuid())
  candidateNumber String   @unique
  name            String
  email           String
  phone           String
  appliedRole     String
  experienceYears Float    @default(0)
  expectedSalary  String?
  resumeUrl       String?
  referenceName   String?  // Reference Name / Referred By
  status          String   @default("NEW") // NEW, ROUND_1_PENDING, ROUND_1_PASSED, ROUND_2_PENDING, ROUND_2_PASSED, ROUND_3_PENDING, HIRED, REJECTED

  round1InterviewerId String?
  round1Interviewer   Employee? @relation("CandidateRound1Interviewer", fields: [round1InterviewerId], references: [id])

  round2InterviewerId String?
  round2Interviewer   Employee? @relation("CandidateRound2Interviewer", fields: [round2InterviewerId], references: [id])

  round3InterviewerId String?
  round3Interviewer   Employee? @relation("CandidateRound3Interviewer", fields: [round3InterviewerId], references: [id])

  overallRating   Float    @default(0)
  finalConclusion String?
  finalDecisionBy String?
  
  evaluations     CandidateEvaluation[]
  roundSummaries  CandidateRoundSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewQuestion {
  id          String   @id @default(uuid())
  roundNumber Int      // 1 = Basic/Screening, 2 = Technical, 3 = Final/HR
  question    String
  category    String?  @default("General")
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluations CandidateEvaluation[]
}

model CandidateEvaluation {
  id          String   @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roundNumber Int
  questionId  String
  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating      Int      // 1 to 5
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CandidateRoundSummary {
  id                  String    @id @default(uuid())
  candidateId         String
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roundNumber         Int
  interviewerId       String?
  interviewerName     String?
  averageRating       Float     @default(0)
  recommendation      String    // ADVANCE, REJECT, HOLD
  feedbackNotes       String?
  completedAt         DateTime  @default(now())
}

// ---------------------------------------------------------
// WhatsApp Business Automation & CRM Platform Models
// ---------------------------------------------------------

model WhatsAppAccount {
  id                 String   @id @default(uuid())
  name               String   // e.g., "Main Sales", "Customer Support"
  phoneNumber        String   // e.g., "+91 9876543210"
  phoneId            String?  // Meta WhatsApp Phone ID
  businessAccountId  String?  // Meta WABA ID
  businessManagerId  String?  // Meta Business Manager ID
  accessToken        String?  // Masked or encrypted token
  webhookVerifyToken String?
  status             String   @default("CONNECTED") // CONNECTED, DISCONNECTED, VERIFICATION_REQUIRED, RESTRICTED
  dailyLimit         String   @default("10K per day")
  usedToday          Int      @default(1250)
  qualityRating      String   @default("GREEN") // GREEN, YELLOW, RED
  isDefault          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations      WhatsAppConversation[]
}

model WhatsAppConversation {
  id                 String   @id @default(uuid())
  accountId          String
  account            WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("AssignedAgent", fields: [assignedEmployeeId], references: [id])

  teamId             String?
  team               Team?    @relation(fields: [teamId], references: [id])

  status             String   @default("OPEN") // OPEN, CLOSED, SNOOZED, PENDING
  priority           String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  leadStatus         String   @default("New Lead") // New Lead, Contacted, Qualified, Negotiation, Won, Lost
  orderStatus        String?  // Processing, Packed, Dispatched, Delivered, Payment Pending
  customerType       String   @default("Wholesale") // Retailer, Wholesaler, Distributor, VIP
  
  aiHandled          Boolean  @default(true)
  aiConfidence       Float    @default(0.92)
  unreadCount        Int      @default(0)
  
  lastMessageText    String?
  lastMessageAt      DateTime @default(now())
  tags               String?  // Comma separated tags e.g. "Hot Lead, Follow-up"
  
  snoozedUntil       DateTime?
  followUpDueAt      DateTime?
  slaStatus          String   @default("GREEN") // GREEN, ORANGE, RED

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages           WhatsAppMessage[]
  paymentLinks       WhatsAppPaymentLink[]
  formSubmissions    WhatsAppFormSubmission[]
}

model WhatsAppMessage {
  id               String   @id @default(uuid())
  conversationId   String
  conversation     WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType       String   // "CUSTOMER", "AGENT", "SYSTEM", "BOT", "AI"
  senderId         String?  // Agent User/Employee ID if applicable
  senderName       String?  
  
  messageType      String   @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT, AUDIO, LOCATION, CONTACT, TEMPLATE, QUICK_REPLY, CATALOG, PAYMENT_LINK, BUTTONS, LIST
  content          String   // Message text or caption
  mediaUrl         String?
  mediaType        String?  // image/png, application/pdf, audio/ogg
  mediaFilename    String?

  templateId       String?
  metadata         String?  // JSON string storing interactive data (buttons, product IDs, payment IDs)
  
  status           String   @default("SENT") // SENT, DELIVERED, READ, FAILED, RECEIVED
  isInternalNote   Boolean  @default(false)
  replyToMessageId String?
  metaMessageId    String?  @unique
  
  sentAt           DateTime @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
}

model WhatsAppTemplate {
  id               String   @id @default(uuid())
  name             String   // e.g., "order_confirmation_v2"
  category         String   @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION
  language         String   @default("en_US")
  status           String   @default("APPROVED") // APPROVED, PENDING, REJECTED, PAUSED
  headerType       String   @default("NONE") // NONE, TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent    String?
  bodyText         String   // Standard body text with {{customer_name}}, {{order_number}}, etc.
  footerText       String?
  buttons          String?  // JSON array of buttons (CTA, QUICK_REPLY)
  variables        String?  // JSON array of dynamic CRM fields
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WhatsAppReplyItem {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("Quick Reply") // Quick Reply, Pitch, Catalog, Payment, Support, Dispatch
  shortcut    String   // e.g. "/catalog", "/price", "/payment", "/followup"
  content     String
  variables   String?  // JSON string
  isPersonal  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhatsAppAutomationRule {
  id           String   @id @default(uuid())
  name         String
  trigger      String   // NEW_MESSAGE, NEW_LEAD, KEYWORD_RECEIVED, PAYMENT_RECEIVED, ORDER_CREATED, NO_RESPONSE_24H
  conditions   String?  // JSON string (customerType, stage, tag, orderValue, location)
  actions      String   // JSON string (sendMessage, assignAgent, addTag, changeStage, createFollowUp, createOrder, sendPaymentLink)
  delayMinutes Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppChatbotFlow {
  id             String   @id @default(uuid())
  name           String
  triggerKeyword String?
  nodesJson      String   // Detailed node tree (Start, Message, Question, Buttons, Catalog, Payment, CRM action, Transfer)
  isActive       Boolean  @default(true)
  executionCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WhatsAppForm {
  id             String   @id @default(uuid())
  title          String
  description    String?
  fieldsJson     String   // Dynamic CRM field mapping (Name, Phone, Email, Company, Requirement, Quantity, Budget, GST)
  submitMessage  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions    WhatsAppFormSubmission[]
}

model WhatsAppFormSubmission {
  id             String   @id @default(uuid())
  formId         String
  form           WhatsAppForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  conversationId String?
  conversation   WhatsAppConversation? @relation(fields: [conversationId], references: [id])

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  dataJson       String
  createdAt      DateTime @default(now())
}

model WhatsAppCampaign {
  id              String   @id @default(uuid())
  name            String
  templateId      String
  segmentId       String?
  scheduledAt     DateTime?
  status          String   @default("COMPLETED") // DRAFT, SCHEDULED, RUNNING, COMPLETED, CANCELLED
  totalAudience   Int      @default(0)
  sentCount       Int      @default(0)
  deliveredCount  Int      @default(0)
  readCount       Int      @default(0)
  repliedCount    Int      @default(0)
  failedCount     Int      @default(0)
  leadsGenerated  Int      @default(0)
  ordersGenerated Int      @default(0)
  revenueGenerated Float   @default(0)
  cost            Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WhatsAppSegment {
  id           String   @id @default(uuid())
  name         String   // High Value, Inactive 90 Days, New Leads, Repeat Buyers, Wholesale
  criteriaJson String
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppPaymentLink {
  id             String   @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId        String?
  invoiceId      String?
  amount         Float
  currency       String   @default("INR")
  paymentUrl     String
  status         String   @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------
// Team Broadcasts & Announcements System
// ---------------------------------------------------------
model TeamBroadcast {
  id              String   @id @default(uuid())
  title           String
  content         String
  category        String   @default("GENERAL") // "OFFER", "HOLIDAY", "ANNOUNCEMENT", "URGENT", "GENERAL", "MEETING"
  priority        String   @default("NORMAL")  // "LOW", "NORMAL", "HIGH", "URGENT"
  
  // Attachments (JSON array of { name: string, url: string, type: string, size?: number })
  attachments     String?  // JSON string
  
  // Audience Targeting
  targetAudience  String   @default("ALL")     // "ALL" or "SELECTED"
  targetUserIds   String[] @default([])        // Array of User IDs
  targetRoles     String[] @default([])        // Array of Roles e.g. ["SALES", "HR"]
  
  // Author
  authorId        String
  author          User     @relation("BroadcastAuthor", fields: [authorId], references: [id])
  
  // Pinned & Status
  isPinned        Boolean  @default(false)
  expiresAt       DateTime?
  
  // Relations
  replies         BroadcastReply[]
  reads           BroadcastRead[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BroadcastReply {
  id              String   @id @default(uuid())
  broadcastId     String
  broadcast       TeamBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  content         String
  attachments     String?  // JSON array of attachments if any
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BroadcastRead {
  id              String   @id @default(uuid())
  broadcastId     String
  broadcast       TeamBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  readAt          DateTime @default(now())

  @@unique([broadcastId, userId])
}

// ---------------------------------------------------------
// WhatsApp Chatbot Flow State (Per-Customer Position Tracking)
