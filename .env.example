# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-unique-secret"

# Deliberate one-time administrator bootstrap only. Remove after use.
# BOOTSTRAP_ADMIN_PASSWORD=""

# AI and external integrations
GEMINI_API_KEY=""
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-unique-secret"
SHIPMOZO_PUBLIC_KEY=""
SHIPMOZO_PRIVATE_KEY=""
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENVIRONMENT="sandbox"

# Internal services and push notifications
CRON_SECRET="replace-with-a-unique-secret"
INTERNAL_API_SECRET="replace-with-a-unique-secret"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
