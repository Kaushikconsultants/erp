# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / AWS RDS)
# ==============================================================================
# Connection pool URL (Port 6543 for Supabase PgBouncer or Neon pooled connection)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct URL used by Prisma CLI for migrations/db push (Port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# NEXTAUTH CONFIGURATION
# ==============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-characters"
# Your production URL on Vercel (or custom domain)
NEXTAUTH_URL="https://your-project.vercel.app"

# ==============================================================================
# GOOGLE GEMINI AI (Smart Call Summaries, WhatsApp AI)
# ==============================================================================
GEMINI_API_KEY=""

# ==============================================================================
# WHATSAPP BUSINESS CLOUD API (Meta Developer Console)
# ==============================================================================
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="espon_whatsapp_secure_webhook_token_2026"

